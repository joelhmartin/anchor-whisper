# Dictation cleanup settings. Copied to <repo root>/.env by setup.sh.
# This file is gitignored; keys never belong in git.

# Cleanup backend: local | anthropic | openai | gemini
DICTATE_BACKEND=local

# Model for the local Claude Code CLI worker: sonnet | haiku | opus
DICTATE_LOCAL_MODEL=sonnet

# Model for an API backend (anthropic/openai/gemini); blank = provider default
DICTATE_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
