# Dictation cleanup settings. Copied to ~/.config/dictate/env by setup.sh.
# Uncomment to use a provider's API instead of the local Claude Code worker.
# DICTATE_BACKEND=local        # local | anthropic | openai | gemini
# DICTATE_MODEL=               # blank = provider default
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
